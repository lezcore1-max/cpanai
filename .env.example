# Copy this file to .env and fill in your key, or export it directly in your shell:
#   export GEMINI_API_KEY=AIza...
#
# Without this set, the Performance (LLM-as-judge) check will fall back to a
# simple heuristic instead of calling the model — the app still runs, but
# groundedness scoring is much weaker.
GEMINI_API_KEY=
